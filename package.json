{
  "name": "dsh-skills-input",
  "version": "0.1.1",
  "description": "DSH Skill selector and skill browser for browsing user-invocable skills and inserting slash commands into the composer.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konglong87/dsh-skills-input.git"
  },
  "homepage": "https://github.com/konglong87/dsh-skills-input#readme",
  "bugs": {
    "url": "https://github.com/konglong87/dsh-skills-input/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "skill",
    "skills",
    "skill-selector",
    "skill-browser",
    "slash-command",
    "composer",
    "agent-skills",
    "技能选择",
    "斜杠命令"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs",
    "screenshots.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "npm run build",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  }
}
